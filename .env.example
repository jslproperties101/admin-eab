# Copy to .env (ignored by Git) or set as GitHub Actions secrets. Never commit real keys.
# Admin EAB uses the SAME Supabase project as Estate Agent AI Buddy. While building: the TEST project (EAB-QA-Test).
# Only the public (anon / publishable) key belongs here. NEVER the service-role key.
EAB_SUPABASE_URL=
EAB_SUPABASE_ANON_KEY=
